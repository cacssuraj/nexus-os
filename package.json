{"name":"nexus-os","version":"0.1.0","private":true,"main":"dist-electron/apps/desktop/electron/main.js","scripts":{"dev":"tsc -p tsconfig.electron.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"","check":"tsc --noEmit && tsc -p tsconfig.electron.json --noEmit","build":"npm run check && vite build && tsc -p tsconfig.electron.json","build:agent:win":"cargo build --locked --release --target x86_64-pc-windows-msvc -p nexus-agent","dist:win":"npm run build:agent:win && npm run build && electron-builder --win nsis --x64"},"dependencies":{"react":"^19.0.0","react-dom":"^19.0.0"},"devDependencies":{"@types/node":"^24.0.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","typescript":"^5.9.0","vite":"^7.0.0","electron":"^45.0.0","electron-builder":"^26.0.0","concurrently":"^9.0.0","wait-on":"^8.0.0"},"build":{"appId":"com.nexus.desktop","productName":"NEXUS OS","files":["dist/**/*","dist-electron/**/*"],"extraResources":[{"from":"target/x86_64-pc-windows-msvc/release/nexus-agent.exe","to":"agent/nexus-agent.exe"}],"win":{"target":[{"target":"nsis","arch":["x64"]}]},"nsis":{"perMachine":false,"oneClick":false,"allowElevation":false,"runAfterFinish":true}}}
